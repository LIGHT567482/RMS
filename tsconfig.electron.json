{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "electron-build",
    "rootDir": "electron",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"],
    "module": "NodeNext",
    "target": "ES2022",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false
  },
  "include": ["electron/**/*.ts"],
  "exclude": ["node_modules", "electron-build"]
}
