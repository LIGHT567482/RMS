{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RMS",
  "version": "0.1.0",
  "identifier": "com.rmsapp.desktop",
  "build": {
    "frontendDist": "../dist-branded",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "RMS",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
